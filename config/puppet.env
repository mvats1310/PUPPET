# PUPPET session configuration: the single place for addresses, names and paths.
#
# Read by ./puppet. Values are the lab values recorded in ReadMe.md (Sections 6-8).
# To change something for one machine or one session without committing it, put the
# override in config/puppet.local.env (git-ignored); it is read after this file.

# ---- Network -------------------------------------------------------------------
# ROS master runs on TIAGo in the lab procedure.
ROS_MASTER_URI=http://10.205.3.26:11311
# This machine (archimedes). Must be one of the addresses in `hostname -I`.
ROS_IP=10.205.3.122
# Motive / NatNet server (gaia).
MOTIVE_IP=10.205.3.3

# ---- TIAGo ---------------------------------------------------------------------
TIAGO_SSH=pal@tiago-38c
TIAGO_SETUP="source /opt/pal/gallium/setup.bash && source ~/deployed_ws_tele/setup.bash"
# ROS-TCP endpoint started by tiago_real.launch; Unity (ROSConnectionPrefab) connects here.
TCP_IP=10.205.3.26
TCP_PORT=10000
TELEPRESENCE_AUDIO=false
PLAY_MOTION_ARGS="arm:=True end_effector:=pal-gripper ft_sensor:=false base_type:=pmb2"
# Pose to reach before teleoperation (defined in tiago_telepresence_controllers/config/telepresence_motions.yaml).
START_MOTION=extend
# Operator procedure: stop PlayMotion once telepresence controllers are running.
# Note: this also makes Unity's /tp_arm_motion/command service unusable for the rest of the session.
STOP_PLAY_MOTION_AFTER_TELEPRESENCE=true

# ---- archimedes ROS environment -------------------------------------------------
ROS_SETUP=/opt/ros/noetic/setup.bash
# Workspace that provides PAL packages, natnet_ros_cpp, optitrack_ros_communication.
TIAGO_WS_SETUP=$HOME/tiago_public_ws/devel/setup.bash
# Separate workspace that provides puppet_bringup, if any. Empty when puppet_bringup is linked
# into tiago_public_ws (what scripts/setup_workspace.sh does).
PUPPET_WS_SETUP=

# ---- OptiTrack -----------------------------------------------------------------
# natnet_ros_cpp publishes /natnet_ros/<Motive rigid-body name>/pose.
BASE_TOPIC=/natnet_ros/umh_tiago_base/pose
# Motive name was reported as umh_mahika_object but the script used umh_object_mahika.
# `./puppet check` lists the real candidates if this one is not published.
PUCK_TOPIC=/natnet_ros/umh_object_mahika/pose
# UDP relays from optitrack_nodes.launch (on in the operator's command).
MOCAP_UDP_CLIENT=true

# ---- tmux ----------------------------------------------------------------------
SESSION=puppet
